@page "/"
@page "/tables"
@using PointsPerGame.UI.Blazor.Services
@using PointsPerGame.Core.Services
@inject Services.TablesService TablesService

<PageTitle>Points Per Game</PageTitle>

<h1>Points Per Game</h1>

<br /> 

<h2>Tables</h2>

@if (links == null)
{
    <p>Loading...</p>
}
else
{
    <div class="table-links">
        @foreach (var link in links)
        {
            @if (link.IsAvailable)
            {
                <a href="/tables/@link.Id">@link.Name</a>
            }
            else
            {
                <span>@link.Name (source unavailable)</span>
            }
            <br />
        }
    </div>

    <br /> 
    <br /> 
    <h2>Sorting</h2>
    <text>Teams are sorted by points per game, then by the number of games played, then goal difference and finally by team name.</text>

    <br />
    <br /> 
    <text>Points per game is calculated from the points earned through wins and draws before any points deduction. Deductions are marked with numbered footnotes on the table.</text>
    <br />
    <br />
    <text>The exception is that if teams have won all their games - which only really happens at the start of the season - then the team which
         has played more games is sorted higher: 9 points from 3 games beats 6 points from 2 games.</text>

   <br />
   <br /> 
   <h2>Appearance</h2>
   <text>The site defaults to a light theme, you can change the theme with these links:</text>
    <br />    <br /> 
    <text><a href="/?mode=light" target="_top">Light mode</a></text>
    <br />     <br /> 
     <text><a href="/?mode=dark" target="_top">Dark mode</a></text>

    <br />
    <br /> 
    <h2>Contact</h2>

    <text>Having a problem?</text>
    <text>Got any ideas for improvements?</text>
    <text><a href="mailto:stuartd.dev+ppg@gmail.com">Send me an email!</a></text>


    <br />
    <br /> 
    <h2>Testimonial:</h2>
    
    <text>"All league tables should be ranked like this" - jimmason4, 2014</text>

    <br />
    <br /> 
    <h2>History:</h2>
    <text>
        <a href="https://web.archive.org/web/20101023000451/http://justkeepswimming.net/tables">Established in 2010</a>
    </text>

    <br />
    <br /> 
    <h2>About:</h2>
    <text>Build ID - @GetLastCommitService.LastShortCommitId</text> <br />
    <text><a href="https://github.com/stuartd/pointspergame.net">The site code (GitHub)</a></text>
}

@code {
    private IReadOnlyList<LeagueLink>? links;

    protected override async Task OnInitializedAsync()
    {
        links = await TablesService.GetLeagueLinksAsync();
    }
}

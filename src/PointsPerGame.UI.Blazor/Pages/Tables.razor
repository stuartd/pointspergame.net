@page "/"
@page "/tables"
@using PointsPerGame.UI.Blazor.Services
@using PointsPerGame.Core.Services
@inject Services.TablesService TablesService

<PageTitle>Points Per Game</PageTitle>

<h1>Points Per Game</h1>

<h2>Tables</h2>

@if (links == null)
{
    <p>Loading...</p>
}
else
{
    <div class="table-links">
        @foreach (var link in links)
        {
            @if (link.IsAvailable)
            {
                <a href="/tables/@link.Id">@link.Name</a>
            }
            else
            {
                <span>@link.Name (source unavailable)</span>
            }
            <br />
        }
    </div>

    <br /> 
    <h2>Sorting</h2>
    <span class="body-text">Teams are sorted by points per game, then by the number of games played, then goal difference and finally by team name.</span>

    <br />    <br /> 
    <span class="body-text">Points per game is calculated from the points earned through wins and draws before any points deduction (which have footnotes.</span>

    <br />   <br /> 
    <span class="body-text">The exception is that if teams have won all their games - which only really happens at the start of the season - then the team which
         has played more games is sorted higher: 9 points from 3 games beats 6 points from 2 games.</span>

   <br />
   <h2>Appearance</h2>
   <span class="body-text">The site defaults to a light theme, you can change the theme with these links:</span>
    <br />   <br /> 
    <text><a href="/?mode=light" target="_top">Light mode</a></text>
     <br /> 
     <text><a href="/?mode=dark" target="_top">Dark mode</a></text>

    <br /> 
    <h2>Contact</h2>

    <span class="body-text">Having a problem? Got any ideas for improvements?</span>
     <br />
    <text><a href="mailto:stuartd.dev+ppg@gmail.com">Send me an email!</a></text>

    <br /> 
    <h2>Testimonial</h2>
    
    <span class="body-text"><i>"All league tables should be ranked like this"</i> - jimmason4, 2014</span>

    <br /> 
    <h2>History</h2>
    <text>
        <a href="https://web.archive.org/web/20101023000451/http://justkeepswimming.net/tables">Established in 2010</a>
    </text>

    <br /> 
    <h2>About</h2>
    <span class="body-text">Build ID - @GetLastCommitService.LastShortCommitId</span> <br />
    <text><a href="https://github.com/stuartd/pointspergame.net">The site code (GitHub)</a></text><br />
}

@code {
    private IReadOnlyList<LeagueLink>? links;

    protected override async Task OnInitializedAsync()
    {
        links = await TablesService.GetLeagueLinksAsync();
    }
}

@page "/"
@page "/tables"
@using PointsPerGame.UI.Blazor.Services
@inject Services.TablesService TablesService

<PageTitle>Points Per Game</PageTitle>

<h1>Points Per Game</h1>

<h2>Tables</h2>

@if (links == null)
{
    <p>Loading...</p>
}
else
{
    <div class="table-links">
        @foreach (var link in links)
        {
            @if (link.IsAvailable)
            {
                <a href="/tables/@link.Id">@link.Name</a>
            }
            else
            {
                <span>@link.Name (source unavailable)</span>
            }
            <br />
        }
    </div>

    <h2>Sorting</h2>
    <text>Teams are sorted by points per game, then by the number of games played, then goal difference and finally by team name.</text>
    <br />
    <br /> 
    <text>Points per game is calculated from the points earned through wins and draws before any points deduction. Deductions are marked with numbered footnotes on the table.</text>
    <br />
    <br />
    <text>The exception is that if teams have won all their games - which only really happens at the start of the season - then the team which
         has played more games is sorted higher: 9 points from 3 games beats 6 points from 2 games.</text>
   <br />
   <br /> 

   <h2>Appearance</h2>
   <text>The page will use your system's preferred color scheme, but you can override that with these links:</text>
    <br />    <br /> 
    <text><a href="https://pointspergame.net?mode=light">Light mode</a></text>
    <br />     <br /> 
     <text><a href="https://pointspergame.net?mode=dark">Dark mode</a></text>
    <br />     <br /> 

    <h2>Contact</h2>

    <text>Having a problem? Got any ideas for improvements? <a href="mailto:stuartd.dev+ppg@gmail.com">Send me an email!</a></text>

    <br />
    <br /> 

    <a href="https://github.com/stuartd/pointspergame.net">Site code (GitHub)</a>
}

@code {
    private IReadOnlyList<LeagueLink>? links;

    protected override async Task OnInitializedAsync()
    {
        links = await TablesService.GetLeagueLinksAsync();
    }
}

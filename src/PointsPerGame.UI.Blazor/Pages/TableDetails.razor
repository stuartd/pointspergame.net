@page "/tables/{leagueId:int}"
@using System.Net
@using PointsPerGame.Core.Models
@using PointsPerGame.UI.Blazor.Services
@inject Services.TablesService TablesService

<PageTitle>@PageTitle</PageTitle>

<nav class="table-navigation" aria-label="Table links">
    <a class="home-link" href="/">Home</a>
    <h1>@PageTitle</h1>
    @if (sourceUrl != null)
    {
        <a class="source-link" href="@sourceUrl" target="_blank" rel="noopener noreferrer">Source data</a>
    }
</nav>

@if (rows == null)
{
    <p>Loading...</p>
}
else if (errorMessage != null)
{
    <Missing Message="@errorMessage"/>
}
else
{
    <div class="table-scroll">
        <table class="teamTable">
            <colgroup>
                <col class="crest-column" />
                <col class="position-column" />
                <col class="team-column" />
                <col class="stat-column" span="7" />
            </colgroup>
            <thead>
            <tr>
                <th class="crest-column"></th>
                <th class="position-column" aria-label="Position"></th>
                <th class="team-column">Team</th>
                <th>
                    <abbr class="stat-label-short" title="Played">P</abbr>
                    <span class="stat-label-long">Played</span>
                </th>
                <th>
                    <abbr class="stat-label-short" title="Won">W</abbr>
                    <span class="stat-label-long">Won</span>
                </th>
                <th>
                    <abbr class="stat-label-short" title="Drawn">D</abbr>
                    <span class="stat-label-long">Drawn</span>
                </th>
                <th>
                    <abbr class="stat-label-short" title="Lost">L</abbr>
                    <span class="stat-label-long">Lost</span>
                </th>
                <th>
                    <abbr class="stat-label-short" title="Goal Difference">GD</abbr>
                    <span class="stat-label-long">Goal Diff</span>
                </th>
                <th>
                    <abbr class="stat-label-short" title="Points">Pts</abbr>
                    <span class="stat-label-long">Points</span>
                </th>
                <th>
                    <abbr class="stat-label-short" title="Points Per Game">PPG</abbr>
                    <span class="stat-label-long">PPG</span>
                </th>
            </tr>
            </thead>
            <tbody>
            @for (var rowIndex = 0; rowIndex < rows.Count; rowIndex++)
            {
                var r = rows[rowIndex];
                var footnoteNumber = GetPointDeductionFootnoteNumber(r);
                <tr id="@(footnoteNumber > 0 ? $"point-deduction-team-{footnoteNumber}" : null)">
                    <td class="crest-column"><img src="@r.TeamCrest" alt="" /></td>
                    <td class="position-column">@(rowIndex + 1)</td>
                    <td class="team-column">
                        @if (string.IsNullOrWhiteSpace(r.TeamUrl))
                        {
                            @r.TeamName
                        }
                        else
                        {
                            <a href="@r.TeamUrl">@r.TeamName</a>
                        }
                        @if (r.PointsDeducted > 0)
                        {
                            <sup class="point-deduction-marker" id="point-deduction-reference-@footnoteNumber">
                                <a href="/tables/@LeagueId#point-deduction-@footnoteNumber" title="Deducted @FormatPoints(r.PointsDeducted)" aria-label="View points deduction note for @r.TeamName">@footnoteNumber</a>
                            </sup>
                        }
                    </td>
                    <td>@r.Played</td>
                    <td>@r.Won</td>
                    <td>@r.Drawn</td>
                    <td>@r.Lost</td>
                    <td>@r.GoalDifference</td>
                    <td>@r.Points</td>
                    <td>@r.PointsPerGame.ToString("F2")</td>
                </tr>
            }
            </tbody>
        </table>

        @if (pointDeductions.Count > 0)
        {
            <ul class="point-deductions" aria-label="Points deductions">
                @for (var index = 0; index < pointDeductions.Count; index++)
                {
                    var footnoteNumber = index + 1;
                    var team = pointDeductions[index];
                    <li id="point-deduction-@footnoteNumber">
                        <sup class="point-deduction-reference">
                            <a href="/tables/@LeagueId#point-deduction-team-@footnoteNumber" title="Go to @team.TeamName in the table" aria-label="Go to @team.TeamName in the table">@footnoteNumber</a>
                        </sup>
                        Deducted @FormatPoints(team.PointsDeducted)
                    </li>
                }
            </ul>
        }

        @if (HasIncompleteTeamDetails)
        {
            <p class="team-data-note">Team crests and fixture links are shown where they’re available from the source data.</p>
        }
    </div>

    @if (unavailableTableNames.Count > 0)
    {
        <aside class="notice unavailable-tables">
            <p>The following leagues are not included because their source data is not available:</p>
            <ul>
                @foreach (var tableName in unavailableTableNames)
                {
                    <li>@tableName</li>
                }
            </ul>
        </aside>
    }
}

@code {
    [Parameter]
    public int LeagueId { get; set; }

    private IReadOnlyList<TeamResults>? rows;
    private string? leagueName;
    private string? errorMessage;
    private string? sourceUrl;
    private List<TeamResults> pointDeductions = [];
    private IReadOnlyList<string> unavailableTableNames = [];

    private string PageTitle => leagueName == null ? "League Table" : $"{leagueName}";

    private bool HasIncompleteTeamDetails => rows?.Any(team =>
        string.IsNullOrWhiteSpace(team.TeamCrest) ||
        string.IsNullOrWhiteSpace(team.TeamUrl)) == true;

    protected override async Task OnParametersSetAsync()
    {
        rows = null;
        pointDeductions = [];
        unavailableTableNames = [];
        errorMessage = null;
        leagueName = TablesService.GetLeagueName(LeagueId);
        sourceUrl = TablesService.GetLeagueSourceUrl(LeagueId);

        if (leagueName == null)
        {
            errorMessage = "Table not found.";
            rows = [];
            return;
        }

        try
        {
            var tableData = await TablesService.GetLeagueTableAsync(LeagueId);
            rows = tableData.Rows;
            unavailableTableNames = tableData.UnavailableTableNames;
            pointDeductions = [.. rows.Where(r => r.PointsDeducted > 0)];

            if (rows.Count < 10)
            {
                errorMessage = "League page not found or data unavailable.";
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            errorMessage = "League page not found or data unavailable.";
            rows = [];
        }
        catch (HttpRequestException)
        {
            errorMessage = "The table could not be loaded right now.";
            rows = [];
        }
        catch (InvalidOperationException)
        {
            errorMessage = "League page not found or data unavailable.";
            rows = [];
        }
    }

    private int GetPointDeductionFootnoteNumber(TeamResults team) =>
        pointDeductions.FindIndex(candidate => ReferenceEquals(candidate, team)) + 1;

    private static string FormatPoints(int points) => $"{points} {(points == 1 ? "point" : "points")}";
}

